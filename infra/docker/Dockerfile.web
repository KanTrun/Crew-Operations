FROM node:22-alpine AS deps
WORKDIR /app
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY apps/web/package.json ./package.json
COPY apps/web/package-lock.json ./package-lock.json
RUN npm ci --no-audit --no-fund

FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1 PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ARG NEXT_PUBLIC_API_URL=http://localhost:8000
ARG NEXT_PUBLIC_GEMINI_LIVE_VOICE_ENABLED=true
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_GEMINI_LIVE_VOICE_ENABLED=$NEXT_PUBLIC_GEMINI_LIVE_VOICE_ENABLED
COPY --from=deps /app/node_modules ./node_modules
COPY apps/web ./
# `apps/web/src/lib/contracts.ts` re-exports `../../../../packages/contracts/ts/contracts`.
# The build context is the repo root, but only `apps/web` is copied above, so the
# contract types must be copied to the path that relative import resolves to.
# `packages/contracts/ts/contracts.ts` is committed (generated by `make contracts`).
COPY packages/contracts/ts ./packages/contracts/ts
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static
COPY --from=builder /app/public ./public
EXPOSE 3000
CMD ["node", "server.js"]
