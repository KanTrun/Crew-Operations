FROM python:3.12-slim
WORKDIR /app

# System deps for Camoufox (Firefox headless) + build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev curl \
    libgtk-3-0 libasound2 libdbus-glib-1-2 libx11-xcb1 \
    libxcomposite1 libxdamage1 libxrandr2 libatk1.0-0 libatk-bridge2.0-0 \
    libpango-1.0-0 libcairo2 libgdk-pixbuf-2.0-0 \
    fonts-liberation fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*

# Toàn bộ package lõi — API import ca_solver / ca_gates / ca_ops / ca_playbook / ca_agents
COPY packages/contracts ./packages/contracts
COPY packages/solver ./packages/solver
COPY packages/gates ./packages/gates
COPY packages/opsengine ./packages/opsengine
COPY packages/playbook ./packages/playbook
COPY packages/agents ./packages/agents
COPY apps/api ./apps/api

RUN pip install --no-cache-dir \
    -e ./packages/contracts \
    -e ./packages/solver \
    -e ./packages/gates \
    -e ./packages/opsengine \
    -e ./packages/playbook \
    -e ./packages/agents \
    -e ./apps/api

# Camoufox: install + fetch binary (for Threads/TikTok browser scraping)
RUN pip install --no-cache-dir -U 'camoufox[geoip]' \
    && python -m camoufox fetch

# Dữ liệu instance NHỊP QUÁN: seed, golden, template phiếu, tham số lao động
COPY config ./config
COPY data ./data
COPY infra/templates ./infra/templates
COPY scripts ./scripts
COPY skills ./skills

# Trạng thái ghi được tách khỏi seed để mount volume không che dữ liệu gốc
ENV PYTHONPATH=/app/apps/api/src \
    PYTHONUNBUFFERED=1 \
    CA_AGENT_MODE=replay \
    NHIPQUAN_DB=/app/var/quan.db \
    NHIPQUAN_SUA=/app/var/so_lan_sua.jsonl \
    NHIPQUAN_CAMNANG=/app/var/cam_nang.json
RUN mkdir -p /app/var /app/data/out

EXPOSE 8000
CMD ["uvicorn", "ca_api.interfaces.http.main:app", "--host", "0.0.0.0", "--port", "8000"]
