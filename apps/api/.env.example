# =================================================================
# Crew-Operations env template — COPY sang .env rồi điền giá trị thật
# KHÔNG commit file .env (đã có trong .gitignore)
# =================================================================

# ─── Agent mode ───
CA_AGENT_MODE=live

# ─── LLM providers ───
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# ─── Facebook Page ───
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token_here
FACEBOOK_PAGE_ID=me
FACEBOOK_PAGE_NAME=Nhịp Quán
NHIPQUAN_FB_PAGE_TOKEN=your_page_access_token_here
NHIPQUAN_FB_PAGE_ID=me
NHIPQUAN_PAGE_MODE=live
NHIPQUAN_FB_WEBHOOK_VERIFY=change-me

# ─── TikTok scraping (Apify primary + TikWM fallback) ───
# Đăng ký free $5/tháng tại https://console.apify.com/
# Settings → Integrations → Token → Create new
APIFY_TOKEN=your_apify_token_here
APIFY_TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
TIKTOK_APIFY_TIMEOUT_S=90