# Copy to `.env` (gitignored). Pytest and CI stay on CA_AGENT_MODE=replay.
CA_AGENT_MODE=replay

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Optional local fallback. Leave unset to skip a hanging localhost probe.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
