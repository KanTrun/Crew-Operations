{
  "$defs": {
    "DataQualityNotice": {
      "description": "Cảnh báo chất lượng dữ liệu — fixture, stale, unavailable phải hiển thị.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "level": {
          "default": "info",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "title": "Level",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "DataQualityNotice",
      "type": "object"
    },
    "ExperienceMode": {
      "description": "Chế độ vận hành của quán — kích hoạt cần proposal + xác nhận quản lý.",
      "enum": [
        "troi_mua",
        "gio_cao_diem",
        "khach_doan",
        "thieu_nhan_su",
        "quan_yen_tinh",
        "dem_nhac"
      ],
      "title": "ExperienceMode",
      "type": "string"
    },
    "ExperienceProposalStatus": {
      "description": "Vòng đời của một đề xuất (proposal) — mọi mutation là proposal trước.",
      "enum": [
        "draft",
        "ready",
        "confirmed",
        "rejected",
        "expired"
      ],
      "title": "ExperienceProposalStatus",
      "type": "string"
    },
    "ExperienceRole": {
      "description": "Vai trò trong không gian trải nghiệm (bản chiếu theo quyền hạn).",
      "enum": [
        "khach",
        "nhan_vien",
        "quan_ly",
        "chu_quan"
      ],
      "title": "ExperienceRole",
      "type": "string"
    },
    "HorizonItem": {
      "description": "Một mục trong tầm nhìn 15 phút tới.",
      "properties": {
        "item_id": {
          "minLength": 1,
          "title": "Item Id",
          "type": "string"
        },
        "kind": {
          "default": "event",
          "enum": [
            "event",
            "signal",
            "handover",
            "mode_proposal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        },
        "source": {
          "enum": [
            "replay",
            "user",
            "system",
            "agent"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "title",
        "starts_at",
        "source"
      ],
      "title": "HorizonItem",
      "type": "object"
    },
    "ModeProjection": {
      "description": "Một chế độ vận hành — kích hoạt cần proposal + xác nhận.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/ExperienceMode"
        },
        "active": {
          "default": false,
          "title": "Active",
          "type": "boolean"
        },
        "proposed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed By"
        },
        "proposal_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExperienceProposalStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode"
      ],
      "title": "ModeProjection",
      "type": "object"
    },
    "PublicEventProjection": {
      "description": "Một sự kiện công khai trên Living Map — không chứa dữ liệu riêng tư.\n\n`zone_id` gắn sự kiện với một khu vực trên mặt bằng. Để trống khi sự kiện\nlà toàn quán: UI phải nói thẳng \"không thuộc khu vực nào\", không suy diễn.",
      "properties": {
        "event_id": {
          "minLength": 1,
          "title": "Event Id",
          "type": "string"
        },
        "event_type": {
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "source": {
          "enum": [
            "replay",
            "user",
            "system",
            "agent"
          ],
          "title": "Source",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "zone_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Zone Id"
        }
      },
      "required": [
        "event_id",
        "event_type",
        "status",
        "occurred_at",
        "source"
      ],
      "title": "PublicEventProjection",
      "type": "object"
    },
    "ZoneProjection": {
      "description": "Một khu vực trên Living Map — bản chiếu theo vai trò.",
      "properties": {
        "zone_id": {
          "minLength": 1,
          "title": "Zone Id",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "active": {
          "default": true,
          "title": "Active",
          "type": "boolean"
        },
        "load_signal": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Load Signal",
          "type": "number"
        }
      },
      "required": [
        "zone_id",
        "label",
        "kind"
      ],
      "title": "ZoneProjection",
      "type": "object"
    }
  },
  "description": "Bản chụp toàn quán theo vai trò — server strip fields trước khi trả.",
  "properties": {
    "snapshot_id": {
      "minLength": 1,
      "title": "Snapshot Id",
      "type": "string"
    },
    "store_id": {
      "default": "quan_01",
      "title": "Store Id",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "role": {
      "$ref": "#/$defs/ExperienceRole"
    },
    "zones": {
      "items": {
        "$ref": "#/$defs/ZoneProjection"
      },
      "title": "Zones",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/PublicEventProjection"
      },
      "title": "Events",
      "type": "array"
    },
    "modes": {
      "items": {
        "$ref": "#/$defs/ModeProjection"
      },
      "title": "Modes",
      "type": "array"
    },
    "next_horizon": {
      "items": {
        "$ref": "#/$defs/HorizonItem"
      },
      "title": "Next Horizon",
      "type": "array"
    },
    "data_quality": {
      "items": {
        "$ref": "#/$defs/DataQualityNotice"
      },
      "title": "Data Quality",
      "type": "array"
    }
  },
  "required": [
    "snapshot_id",
    "role"
  ],
  "title": "LivingCafeSnapshot",
  "type": "object"
}