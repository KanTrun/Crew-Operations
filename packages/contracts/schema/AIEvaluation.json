{
  "title": "AIEvaluation",
  "type": "object",
  "required": ["id", "store_id", "generation_id", "channel", "scores", "aggregate_score", "passed", "action", "threshold_version", "calibration_version", "sample_count", "evaluation_window", "evaluator", "idempotency_key", "created_at"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "store_id": {"type": "string", "minLength": 1},
    "generation_id": {"type": "string", "minLength": 1},
    "channel": {"enum": ["gmail", "facebook"]},
    "scores": {"type": "object", "required": ["accuracy", "safety"]},
    "aggregate_score": {"type": "number", "minimum": 0, "maximum": 1},
    "passed": {"type": "boolean"},
    "action": {"enum": ["auto_send", "queue_review", "priority_review", "escalate_owner", "block_polite", "block_silent"]},
    "hard_fail_flags": {"type": "array", "items": {"type": "string"}},
    "flags": {"type": "array", "items": {"type": "string"}},
    "threshold_version": {"type": "string", "minLength": 1},
    "calibration_version": {"type": "string", "minLength": 1},
    "sample_count": {"type": "integer", "minimum": 0},
    "evaluation_window": {"type": "string", "minLength": 1},
    "evaluator": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1}
  }
}