#!/bin/sh
# Pre-push hook — chạy toàn bộ review trước khi push lên GitHub.
# Chặn push nếu bất kỳ bước nào fail (ruff, secret, mypy, tsc, pytest).
#
# Được cài tự động bởi `python scripts/install_hooks.py`.
# Bỏ qua bằng: git push --no-verify
#
# Mẹo: dùng `git push --no-verify` chỉ khi bạn CHẮC CHẮN thay đổi không ảnh
# hưởng code (vd chỉ sửa docs). Với thay đổi code, hãy để hook chạy.

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Cho phép bỏ qua qua biến môi trường (dùng cho CI/script tự động)
if [ "$SKIP_PRE_PUSH" = "1" ]; then
    echo "⏭️  SKIP_PRE_PUSH=1 — bỏ qua pre-push review."
    exit 0
fi

# Tìm Python 3.12+
PY=""
if command -v py >/dev/null 2>&1; then
    PY="$(py -3.12 -c "import sys; print(sys.executable)" 2>/dev/null || echo "")"
fi
if [ -z "$PY" ]; then
    PY="$(command -v python3 || command -v python || echo "")"
fi
if [ -z "$PY" ]; then
    echo "⚠️  Không tìm thấy Python — bỏ qua pre-push hook."
    exit 0
fi

echo "🚀 Pre-push: chạy toàn bộ review (ruff + secret + mypy + tsc + pytest)..."
echo "   (Bỏ qua nhanh: SKIP_PRE_PUSH=1 git push)"

# Chạy review đầy đủ. Nếu fail → chặn push.
if ! "$PY" scripts/pre_push_review.py; then
    echo ""
    echo "❌ PRE-PUSH REVIEW THẤT BẠI — KHÔNG CHO PUSH LÊN GITHUB."
    echo "   Sửa lỗi rồi push lại, hoặc dùng `git push --no-verify` nếu chỉ sửa docs."
    exit 1
fi

echo "✅ Pre-push: toàn bộ review xanh. Tiếp tục push."
exit 0